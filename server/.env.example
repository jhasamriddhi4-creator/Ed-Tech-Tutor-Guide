# Copy to .env for local development. Never commit actual secrets.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=your_available_gemini_model
AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
PORT=5000
NODE_ENV=development

# Comma-separated frontend origins allowed by the API. Set to your deployed HTTPS frontend origin(s) in production.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
